# Python
__pycache__/
*.py[cod]
.venv/
venv/

# pytest 跑完留下的缓存
.pytest_cache/

# 模型缓存（几百 MB，不进仓库）
.cache/
*.onnx

# 环境变量 / 密钥 —— 绝对不要提交
.env
.env.*
# ★ 但模板必须能提交！上面那行 .env.* 会把 .env.example 一起挡掉，
#   所以这里显式放行。新增 .env.xxx 模板时照抄这一行的写法。
!.env.example
*.key

# 编辑器
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db

# 语料转换的临时中间产物（源头文件是学院内部文件，绝不进公开仓库）
.tmp_extract/
